# Uploads to the stores. Run by .github/workflows/release.yml (internal
# testing and TestFlight, on every v* tag) and .github/workflows/store.yml
# (production, by hand) — and runnable from a Mac the same way:
#
#   fastlane android internal aab:build/app/outputs/bundle/release/app-release.aab
#   fastlane android production rollout:0.2
#   fastlane ios beta
#   fastlane ios release version:1.0.0
#
# Every credential comes from the environment, and every one of them is a
# GitHub secret in CI. None of them is ever written into this repository.
# docs/phase-10-release.md section 3 says how to make each one.
#
# Nothing here builds the Flutter app. The workflow builds it — with the
# build number it chose — and these lanes only sign, upload and promote, so
# the binary a store gets is the binary the tests ran against.

# No usage reporting from the build tools either: the game has no analytics,
# and neither does the thing that ships it.
opt_out_usage

PACKAGE = "com.mohager.waraya"

require "tmpdir"

# "What's new", one file per language in fastlane/release_notes/, read on
# every upload. Edit them before a release (before Actions -> bump); they
# go to Play with the internal-testing build and travel with it when it is
# promoted, and to the App Store with the submission. Each store names the
# languages its own way, hence the two maps.
NOTES_DIR = File.join(__dir__, "release_notes")

def release_notes(locales)
  locales.to_h do |file, locale|
    text = File.read(File.join(NOTES_DIR, "#{file}.txt"), encoding: "UTF-8").strip
    UI.user_error!("fastlane/release_notes/#{file}.txt is empty") if text.empty?
    [locale, text]
  end
end

# Uploads only: the listing text and images are kept in the consoles by hand
# for now (docs/store-listing.md), so a lane never overwrites what is there.
SKIP_LISTING = {
  skip_upload_metadata: true,
  skip_upload_changelogs: true,
  skip_upload_images: true,
  skip_upload_screenshots: true,
}.freeze

# Play's language codes for the two notes files.
PLAY_NOTES = { "ar" => "ar", "en" => "en-US" }.freeze

# App Store Connect's.
APP_STORE_NOTES = { "ar" => "ar-SA", "en" => "en-US" }.freeze

platform :android do
  def play_key
    ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON")
  end

  desc "Upload an AAB to the internal testing track"
  lane :internal do |options|
    upload_to_play_store(
      package_name: PACKAGE,
      json_key_data: play_key,
      track: "internal",
      aab: options.fetch(:aab),
      # A Play app that has never been released is a "draft app", and Play
      # only accepts draft releases into it. Set the repository variable
      # PLAY_RELEASE_STATUS to "draft" until the first release is out, then
      # remove it.
      release_status: ENV.fetch("PLAY_RELEASE_STATUS", "completed"),
      # The release notes, laid out the way supply reads them —
      # <language>/changelogs/default.txt — in a folder made for this upload,
      # so nothing else of the listing is read or touched.
      metadata_path: play_notes_folder,
      **SKIP_LISTING,
      skip_upload_changelogs: false,
    )
  end

  def play_notes_folder
    dir = Dir.mktmpdir("play-notes")
    release_notes(PLAY_NOTES).each do |locale, text|
      UI.user_error!("Play allows 500 characters of release notes; #{locale} has #{text.length}") if text.length > 500
      FileUtils.mkdir_p(File.join(dir, locale, "changelogs"))
      File.write(File.join(dir, locale, "changelogs", "default.txt"), text)
    end
    dir
  end

  desc "Promote a build from internal testing to production"
  lane :production do |options|
    code = options[:version_code].to_s
    if code.empty?
      code = google_play_track_version_codes(
        package_name: PACKAGE,
        json_key_data: play_key,
        track: "internal",
      ).max.to_s
    end
    UI.user_error!("internal testing has no build to promote") if code.empty?

    # A fraction under 1 is a staged rollout: that share of users get it now,
    # and the rest when it is raised in the console.
    rollout = (options[:rollout] || "1").to_f
    UI.user_error!("rollout must be above 0 and at most 1") unless rollout > 0 && rollout <= 1
    staged = rollout < 1

    upload_to_play_store(
      package_name: PACKAGE,
      json_key_data: play_key,
      track: "internal",
      track_promote_to: "production",
      version_code: code.to_i,
      track_promote_release_status: staged ? "inProgress" : "completed",
      rollout: staged ? rollout.to_s : nil,
      skip_upload_apk: true,
      skip_upload_aab: true,
      **SKIP_LISTING,
    )
    UI.success("version code #{code} promoted to production at #{(rollout * 100).round}%")
  end
end

platform :ios do
  def api_key
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true,
    )
  end

  # The states in which a version is closed to new builds: approved, on sale,
  # or on its way there. Apple refuses a TestFlight upload for such a version
  # — after the whole build and signing, with a message about "the previously
  # approved version". Both fields, because Apple has been moving from
  # appStoreState to appVersionState and an app can carry either.
  CLOSED = %w[
    ACCEPTED
    PENDING_APPLE_RELEASE
    PENDING_DEVELOPER_RELEASE
    PROCESSING_FOR_APP_STORE
    PROCESSING_FOR_DISTRIBUTION
    PREORDER_READY_FOR_SALE
    READY_FOR_SALE
    READY_FOR_DISTRIBUTION
    REPLACED_WITH_NEW_VERSION
  ].freeze

  desc "Fail now if this version is already approved or live on the App Store"
  lane :check_version do |options|
    version = options.fetch(:version)
    api_key
    app = Spaceship::ConnectAPI::App.find(PACKAGE)
    UI.user_error!("no app with bundle id #{PACKAGE} in App Store Connect") if app.nil?

    closed = app.get_app_store_versions(filter: { platform: "IOS" }).select do |v|
      CLOSED.include?(v.app_version_state) || CLOSED.include?(v.app_store_state)
    end
    newest = closed.map { |v| Gem::Version.new(v.version_string) }.max

    if newest && Gem::Version.new(version) <= newest
      segments = newest.segments + [0, 0, 0]
      UI.user_error!(
        "#{version} is not above #{newest}, which is already approved or live " \
        "on the App Store, and Apple refuses new builds for it. Bump the version: " \
        "Actions -> bump -> patch makes it #{segments[0]}.#{segments[1]}.#{segments[2] + 1}."
      )
    end
    UI.success("#{version} is open for new builds (newest approved: #{newest || "none"})")
  end

  desc "Sign the built app and upload it to TestFlight"
  lane :beta do
    key = api_key

    # A throwaway keychain for this run, with the distribution certificate
    # in it. The certificate is the one made once on the owner's Mac; making
    # a new one per run would hit Apple's limit of a few at a time.
    setup_ci
    import_certificate(
      certificate_path: ENV.fetch("IOS_CERTIFICATE_PATH"),
      certificate_password: ENV.fetch("IOS_CERTIFICATE_PASSWORD"),
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: "",
    )

    # The App Store profile is fetched — or made, the first time — through
    # the API key, so it never has to be exported or kept as a secret.
    get_provisioning_profile(api_key: key, app_identifier: PACKAGE)
    profile = lane_context[SharedValues::SIGH_NAME]

    # Manual signing for this run only, on the app target only: the project
    # in the repository stays on automatic signing, which is what Xcode on
    # the owner's Mac wants, and the plugin pods are not touched (giving them
    # a profile fails the build).
    update_code_signing_settings(
      path: "ios/Runner.xcodeproj",
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      targets: ["Runner"],
      code_sign_identity: "Apple Distribution",
      profile_name: profile,
    )

    build_app(
      workspace: "ios/Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      export_options: { provisioningProfiles: { PACKAGE => profile } },
      output_directory: "build/ios/fastlane",
    )

    # Not waiting for Apple to process it: that takes ten to thirty minutes
    # of a macOS runner doing nothing. The build shows up in TestFlight on
    # its own, and Apple emails when it is ready.
    upload_to_testflight(api_key: key, skip_waiting_for_build_processing: true)
  end

  # TestFlight's languages: Arabic first, as in App Store Connect.
  TESTFLIGHT_LOCALES = { "ar" => "ar-SA", "en" => "en-US" }.freeze

  # "What is this app", from fastlane/testflight_description/, and the
  # feedback address when the TESTFLIGHT_FEEDBACK_EMAIL variable is set —
  # a variable, so no address is written into the repository. Without it,
  # whatever App Store Connect already has is left as it is.
  def testflight_app_info
    email = ENV["TESTFLIGHT_FEEDBACK_EMAIL"].to_s.strip
    TESTFLIGHT_LOCALES.to_h do |file, locale|
      text = File.read(File.join(__dir__, "testflight_description", "#{file}.txt"), encoding: "UTF-8").strip
      UI.user_error!("fastlane/testflight_description/#{file}.txt is empty") if text.empty?
      info = { description: text }
      info[:feedback_email] = email unless email.empty?
      [locale, info]
    end
  end

  desc "Send a TestFlight build to the external testers (through Beta App Review)"
  lane :external do |options|
    version = options.fetch(:version)
    build = options.fetch(:build).to_s
    group = ENV.fetch("TESTFLIGHT_EXTERNAL_GROUP", "Mohager External")
    key = api_key

    # A build cannot go to anyone until Apple has processed it, and `beta`
    # does not wait for that (ten to thirty minutes of an idle macOS runner).
    # This lane runs on Linux, where waiting is cheap — it polls until the
    # build has appeared and finished processing.
    app = Spaceship::ConnectAPI::App.find(PACKAGE)
    UI.user_error!("no app with bundle id #{PACKAGE} in App Store Connect") if app.nil?
    FastlaneCore::BuildWatcher.wait_for_build_processing_to_be_complete(
      app_id: app.id,
      platform: "IOS",
      app_version: version,
      build_version: build,
      poll_interval: 60,
      timeout_duration: 90 * 60,
      return_spaceship_testflight_build: false,
      wait_for_build_beta_detail_processing: true,
    )

    upload_to_testflight(
      api_key: key,
      app_identifier: PACKAGE,
      distribute_only: true,
      # Without an .ipa there is nothing to read the platform from, and
      # pilot stops to ask for it — which, on CI, is a crash.
      app_platform: "ios",
      app_version: version,
      build_number: build,
      distribute_external: true,
      groups: [group],
      # TestFlight's "Test Information" (what the app is, and where feedback
      # goes) and the build's "What to Test", one entry per language. Named
      # languages rather than a default: a default only fills languages that
      # already exist, and on a fresh app none do — Apple then refuses the
      # submission with "Beta App Description is missing".
      localized_app_info: testflight_app_info,
      localized_build_info: TESTFLIGHT_LOCALES.to_h do |_, locale|
        [locale, { whats_new: File.read(File.join(__dir__, "what_to_test.txt"), encoding: "UTF-8").strip }]
      end,
      notify_external_testers: true,
      # Only HTTPS through the OS — the same answer as Info.plist gives.
      uses_non_exempt_encryption: false,
      # A newer build replaces one still waiting for Beta App Review rather
      # than queueing behind it: the testers want the latest, not both.
      reject_build_waiting_for_review: true,
    )
    UI.success("#{version} (#{build}) submitted to Beta App Review for \"#{group}\"")
  end

  desc "Submit a TestFlight build for App Store review"
  lane :release do |options|
    key = api_key

    # Apple refuses "What's New" on an app's first version — there is
    # nothing it is new against — so it is sent only once a version is live.
    app = Spaceship::ConnectAPI::App.find(PACKAGE)
    UI.user_error!("no app with bundle id #{PACKAGE} in App Store Connect") if app.nil?
    first = app.get_live_app_store_version.nil?
    notes = first ? {} : release_notes(APP_STORE_NOTES)

    # Only languages the version already has. Notes in a language it does not
    # have would create that localization with nothing else in it, and Apple
    # refuses to review a version with a half-filled language.
    unless notes.empty?
      version = app.get_app_store_versions(
        filter: { platform: "IOS", versionString: options.fetch(:version) },
      ).first
      have = version ? version.get_app_store_version_localizations.map(&:locale) : []
      skipped = notes.keys - have
      UI.important("No #{skipped.join(", ")} on this version: its notes are not sent") unless skipped.empty?
      notes = notes.slice(*have)
    end
    UI.message(first ? "First version: no \"What's New\" to send" : "What's New: #{notes.keys.join(", ")}")

    deliver(
      api_key: key,
      app_identifier: PACKAGE,
      app_version: options.fetch(:version),
      # Empty means the newest build uploaded for that version.
      build_number: options[:build].to_s.empty? ? nil : options[:build].to_s,
      skip_binary_upload: true,
      # Metadata on only to carry the release notes. The folder it would read
      # the rest of the listing from is empty, so nothing else is changed —
      # the listing is kept in App Store Connect (docs/store-listing.md).
      skip_metadata: first,
      metadata_path: Dir.mktmpdir("app-store-metadata"),
      release_notes: notes,
      skip_screenshots: true,
      submit_for_review: true,
      # Released the moment Apple approves it.
      automatic_release: true,
      force: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
      },
    )
  end
end
