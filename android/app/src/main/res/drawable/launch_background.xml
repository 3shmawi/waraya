<?xml version="1.0" encoding="utf-8"?>
<!-- The launch screen: the sky, and the mark in the middle of it — what the
     web splash and the landing page open on, instead of a white screen. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_sky" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
